generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  purchases    Purchase[]
  accounts     Account[]
}

/// Identidade externa vinculada a um User (ex.: Google).
///
/// Guarda apenas o vínculo: o identificador estável do provedor
/// (`providerAccountId`, ex.: o `sub` do Google) e nada sensível — não
/// armazenamos email, nome, avatar, tokens, ID token nem segredos.
model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum DocumentType {
  INVOICE
  RECEIPT
  WARRANTY
  OTHER
}

model Purchase {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  productName  String
  brand        String?
  model        String?
  serialNumber String?
  store        String?
  purchaseDate DateTime
  price        Decimal   @db.Decimal(12, 2)
  category     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warranty     Warranty?
  documents    Document[]

  @@index([userId])
}

model Document {
  id          String       @id @default(uuid()) @db.Uuid
  purchaseId  String       @db.Uuid
  name        String
  fileName    String
  mimeType    String
  size        Int
  storagePath String
  type        DocumentType @default(OTHER)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  purchase    Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([purchaseId])
}

model Warranty {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseId     String   @unique @db.Uuid
  durationMonths Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([endDate])
}
