PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/garantia"
# Generate with: openssl rand -hex 48
ACCESS_TOKEN_SECRET=
# Generate with: openssl rand -hex 48
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AI_PROVIDER=unconfigured
AI_API_KEY=
AI_API_URL=
GEMINI_API_KEY=
# Provider NVIDIA (AI_PROVIDER=nvidia). Chave da API hospedada da NVIDIA.
NVIDIA_API_KEY=
# Login com Google (opcional). Enquanto vazio, POST /auth/google responde
# 400 GOOGLE_AUTH_NOT_CONFIGURED e o login tradicional segue funcionando.
# Sem Client Secret: o backend validará o ID token (Google Identity Services).
GOOGLE_CLIENT_ID=
